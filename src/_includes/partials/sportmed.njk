{#
  sportmed.njk — Section partenaire médical.
  Mention neutre de SportMed360 (pas de pub médicale).
  Background gray-100 pour séparation visuelle avec #about.
#}
<section id="sportmed" class="sportmed-section">
  <div class="container">
    <div class="about-grid">

      {# Colonne Texte #}
      <div class="about-content">
        <div class="sportmed-badge">Partenaire Santé</div>
        <h2 class="section-title">{{ home.sportmed.title }}</h2>
        <p class="about-body">{{ home.sportmed.description }}</p>

        <div class="prose-note">
          Note : evo360 et SportMed360 sont deux entités distinctes. Les prestations médicales (consultations, infiltrations, etc.) sont assurées exclusivement par les médecins de SportMed360.
        </div>

        <div style="margin-top: 2rem;">
          <a href="{{ home.sportmed.link_url }}" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
            {{ home.sportmed.link_text }} <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      {# Colonne Visuel — Carte améliorée #}
      <div class="about-image">
        <div class="sportmed-card-enhanced">
          <div class="sportmed-card-bg" aria-hidden="true"></div>
          <img src="{{ home.sportmed.logo }}" alt="Logo SportMed360" class="sportmed-logo-img" loading="lazy">
          <p class="sportmed-card-tagline">Médecine du sport & traumatologie</p>
        </div>
      </div>

    </div>
  </div>
</section>
