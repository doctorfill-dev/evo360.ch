<section id="pricing" class="pricing">
  <div class="container">
    <div class="pricing-header">
      <h2 class="section-title">{{ home.pricing.title | safe }}</h2>
      <p>{{ home.pricing.description }}</p>
    </div>

    <div class="pricing-grid">
      {% for plan in home.pricing.plans %}
        <div class="pricing-card {% if plan.highlight %}highlighted{% endif %}">
          <div class="plan-header">
            <h3>{{ plan.name }}</h3>

            <div class="plan-price">
              <div class="price-monthly">
                <span class="amount">{{ plan.price_months }}</span>
                <span class="period">{{ plan.period_months }}</span>
              </div>
              <div class="price-onetime">
                <span><strong>ou {{ plan.price_onetime }} {{ plan.period_onetime }}</strong></span>
              </div>
            </div>
            <p class="plan-desc">{{ plan.description }}</p>
          </div>

          <ul class="plan-features">
            {% for feature in plan.features %}
              <li>
                <svg viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                {{ feature }}
              </li>
            {% endfor %}
          </ul>

          <div class="plan-cta">
            <a href="/contact/?motif=Abonnement+{{ plan.name | urlencode }}" class="btn {% if plan.highlight %}btn-primary{% else %}btn-outline{% endif %}">
              {{ plan.cta_label }}
            </a>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="pricing-all-link">
      <a href="/tarifs/" class="btn btn-outline">
        Voir tous nos tarifs
        <svg class="icon" style="width:1rem;height:1rem;vertical-align:middle;" aria-hidden="true"><use href="/assets/img/icons/sprite.svg#icon-arrow_forward"></use></svg>
      </a>
    </div>
  </div>
</section>
