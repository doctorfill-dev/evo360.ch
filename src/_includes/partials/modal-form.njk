{#
  modal-form.njk — Modal de contact avec formulaire Formspree.
  Inclus dans base.njk pour être accessible depuis toutes les pages.
  Ouvert via data-open-modal="contact" sur n'importe quel bouton/lien.
  Le motif peut être pré-rempli via data-motif="Abonnement 3 mois".
#}
<div class="modal-overlay" id="modal-contact" aria-hidden="true" inert role="dialog" aria-modal="true" aria-labelledby="modal-contact-title">
  <div class="modal-container">
    <button class="modal-close" aria-label="Fermer" id="modal-close">
      <svg class="icon" aria-hidden="true"><use href="/assets/img/icons/sprite.svg#icon-close"></use></svg>
    </button>

    <div class="modal-header">
      <h2 id="modal-contact-title">Nous <span class="accent">contacter</span></h2>
      <p class="modal-subtitle">Remplissez le formulaire et nous vous recontacterons rapidement.</p>
    </div>

    <div class="modal-notice">
      <svg class="icon" style="width:1.125rem;height:1.125rem;vertical-align:middle;" aria-hidden="true"><use href="/assets/img/icons/sprite.svg#icon-info"></use></svg>
      Nous migrons actuellement de système de réservation. En attendant, utilisez ce formulaire.
    </div>

    <form action="https://formspree.io/f/mgonoqwn" method="POST" class="modal-form" id="contact-form">
      <div class="form-row">
        <div class="form-group">
          <label for="prenom">Prénom</label>
          <input type="text" id="prenom" name="prenom" placeholder="Votre prénom" autocomplete="given-name">
        </div>
        <div class="form-group">
          <label for="nom">Nom</label>
          <input type="text" id="nom" name="nom" placeholder="Votre nom" autocomplete="family-name">
        </div>
      </div>
      <div class="form-group">
        <label for="email">Email <span class="required">*</span></label>
        <input type="email" id="email" name="email" placeholder="votre@email.ch" required autocomplete="email">
      </div>
      <div class="form-group">
        <label for="motif">Motif</label>
        <select id="motif" name="motif">
          <option value="">Sélectionnez un motif</option>
          <option value="Renseignement général">Renseignement général</option>
          <option value="Check-Up 360">Check-Up 360</option>
          <option value="Test de VO₂max">Test de VO₂max</option>
          <option value="Coaching &amp; préparation physique">Coaching &amp; préparation physique</option>
          <option value="Profilage">Profilage</option>
          <option value="Fitness &amp; Sauna">Fitness &amp; Sauna</option>
          <option value="Red Light Therapy">Red Light Therapy</option>
          <option value="Nutrition">Nutrition</option>
          <option value="Neurotracker">Neurotracker</option>
          <option value="Entreprises &amp; institutions">Entreprises &amp; institutions</option>
          <option value="Abonnement 3 mois">Abonnement 3 mois</option>
          <option value="Abonnement 6 mois">Abonnement 6 mois</option>
          <option value="Abonnement 12 mois">Abonnement 12 mois</option>
          <option value="Autre">Autre</option>
        </select>
      </div>
      <div class="form-group">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="3" placeholder="Votre message (facultatif)"></textarea>
      </div>
      <p class="form-error-msg" id="form-error" hidden style="color:#c0392b;font-size:.875rem;margin-bottom:.5rem;">
        Une erreur est survenue. Veuillez réessayer ou nous appeler au 076 507 03 60.
      </p>
      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;" id="form-submit-btn">
        <svg class="icon" style="width:1.125rem;height:1.125rem;" aria-hidden="true"><use href="/assets/img/icons/sprite.svg#icon-send"></use></svg>
        Envoyer
      </button>
    </form>

    <div id="form-success" hidden style="text-align:center;padding:2rem 0;">
      <svg style="width:3rem;height:3rem;color:var(--indigo);margin-bottom:1rem;display:block;margin-left:auto;margin-right:auto;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      <h3 style="margin-bottom:.5rem;">Message envoyé !</h3>
      <p style="color:var(--gray-600);">Merci, nous vous recontacterons dans les plus brefs délais.</p>
    </div>
  </div>
</div>
