{#
  blog_preview.njk — Aperçu des 3 derniers articles.
  Utilise loop.index <= 3 pour fiabilité (au lieu de batch).
#}
<section id="blog" class="blog-section">
  <div class="container">
    <div class="blog-header">
      <h2 class="section-title">Conseils & <span class="accent">Expertise</span></h2>
      <p class="blog-header-desc">Découvrez nos derniers articles pour optimiser votre performance et votre bien-être au quotidien.</p>
    </div>

    <div class="blog-grid">
      {% set posts = collections.posts | reverse %}
      {% for post in posts %}
        {% if loop.index <= 3 %}
          <a href="{{ post.url }}" class="blog-card">
            {% if post.data.cover_image %}
              <img src="{{ post.data.cover_image }}" alt="{{ post.data.title }}" loading="lazy">
            {% endif %}
            {% if post.data.publishedDate %}
              <div class="blog-meta">
                <span>{{ post.data.publishedDate | readableDate }}</span>
              </div>
            {% endif %}
            <h3>{{ post.data.title }}</h3>
            <p>{{ post.data.summary }}</p>
            <span class="read-more">Lire l'article →</span>
          </a>
        {% endif %}
      {% endfor %}
    </div>

    <div style="text-align: center; margin-top: 4rem;">
      <a href="/blog/" class="btn btn-outline">Voir tous les articles</a>
    </div>
  </div>
</section>
