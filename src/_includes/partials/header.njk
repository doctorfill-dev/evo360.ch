{# header.njk — Logo SVG + nav avec dropdowns. Transparent → frosted glass (.is-scrolled via JS). #}
<header class="header" id="site-header">
  <div class="container header-inner">

    <a href="/" class="logo" aria-label="{{ home.site.name }}">
      <img src="/assets/img/logo.svg" alt="{{ home.site.name }}" class="logo-img" width="147" height="32">
    </a>

    <nav class="nav" aria-label="Navigation principale">
      <ul class="nav-list">
        {% for link in home.nav.links %}
          {% if '/blog' in link.url %}
          {% elif link.children and link.children.length > 0 %}
            <li class="nav-dropdown-parent">
              <a href="{{ link.url }}" class="nav-link">
                {{ link.label }}
                <svg class="icon nav-chevron" aria-hidden="true"><use href="/assets/img/icons/sprite.svg#icon-expand_more"></use></svg>
              </a>
              <div class="nav-dropdown">
                <ul class="dropdown-list">
                  {% for child in link.children | filterHiddenServiceLinks(collections.services) %}
                    <li><a href="{{ child.url }}" class="dropdown-link">{{ child.label }}</a></li>
                  {% endfor %}
                </ul>
              </div>
            </li>
          {% else %}
            <li><a href="{{ link.url }}" class="nav-link">{{ link.label }}</a></li>
          {% endif %}
        {% endfor %}
      </ul>
    </nav>

    <div class="header-actions">
      <a href="{{ home.nav.cta.url }}" class="btn btn-primary btn-sm">
        {{ home.nav.cta.label }}
      </a>
    </div>

    <button class="nav-burger" id="nav-burger" aria-label="Ouvrir le menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

  </div>

  <div class="mobile-nav" id="mobile-nav" hidden>
    <div class="container">
      <ul class="mobile-nav-list">
        {% for link in home.nav.links %}
          {% if '/blog' in link.url %}
          {% else %}
          <li>
            <a href="{{ link.url }}" class="mobile-nav-link">{{ link.label }}</a>
            {% if link.children and link.children.length > 0 %}
              <ul class="mobile-sub-list">
                {% for child in link.children | filterHiddenServiceLinks(collections.services) %}
                  <li><a href="{{ child.url }}" class="mobile-sub-link">{{ child.label }}</a></li>
                {% endfor %}
              </ul>
            {% endif %}
          </li>
          {% endif %}
        {% endfor %}
        <li style="padding-top:.5rem;">
          <a href="{{ home.nav.cta.url }}" class="btn btn-primary" style="width:100%;justify-content:center;">
            {{ home.nav.cta.label }}
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>
