{#
  contact.njk — Section contact (infos + carte).
  Le formulaire est dans le modal (modal-form.njk).
#}
<section class="contact section-dark" id="contact">
  <div class="container">

    {# En-tête #}
    <div class="contact-header">
      <h2 class="section-title">{{ home.contact.title | safe }}</h2>
      <p class="contact-desc">{{ home.contact.description }}</p>
    </div>

    {# Layout : map | infos #}
    <div class="contact-layout">

      {# Carte Google Maps #}
      <div class="contact-map">
        <iframe
          src="https://maps.google.com/maps?q=evo360+Av.+Edouard-Dubois+20+Neuchatel&output=embed&z=16&hl=fr"
          title="evo360 — Av. Édouard-Dubois 20, Neuchâtel"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen>
        </iframe>
      </div>

      {# Infos de contact empilées #}
      <div class="contact-info">

        <div class="contact-item">
          <div class="ci-icon ci-indigo">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div class="ci-text">
            <strong>Adresse</strong>
            <p>Av. Édouard-Dubois 20<br>2000 Neuchâtel</p>
          </div>
        </div>

        <div class="contact-item">
          <div class="ci-icon ci-indigo">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <div class="ci-text">
            <strong>Téléphone</strong>
            <p><a href="tel:{{ home.site.phone | replace(' ', '') }}">{{ home.site.phone }}</a></p>
          </div>
        </div>

        <div class="contact-item">
          <div class="ci-icon ci-indigo">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <div class="ci-text">
            <strong>Email</strong>
            <p><a href="mailto:{{ home.site.email }}">{{ home.site.email }}</a></p>
          </div>
        </div>

        <div class="contact-item">
          <div class="ci-icon ci-indigo">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>
          </div>
          <div class="ci-text">
            <strong>Accès</strong>
            <p>Parking gratuit — Bus 101, Vauseyon</p>
          </div>
        </div>

        <div class="contact-cta">
          <a href="#" class="btn btn-citron" data-open-modal="contact">
            <svg class="icon" style="width:1.125rem;height:1.125rem;" aria-hidden="true"><use href="/assets/img/icons/sprite.svg#icon-mail"></use></svg>
            Nous écrire
          </a>
        </div>

      </div>

    </div>
  </div>
</section>
