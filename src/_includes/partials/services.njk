{#
  services.njk — Section sombre (fond --dark). Titre aligné à gauche.
  Pas de `eyebrow` — le design Vue n'en a pas. Titre direct avec .accent-citron.
#}
<section class="services section-dark" id="services">
  <div class="container">

    <div class="services-header">
      <h2 class="section-title">
        Avec vous. Pour vous.<br>
        <span class="accent-citron">À chaque étape.</span>
      </h2>
      <p class="services-desc">Chaque parcours est pensé pour vous, selon votre histoire, vos besoins et vos envies. Une expertise variée pour une approche globale.</p>
    </div>

    <div class="services-grid">
      {% set services = collections.services | removeHidden | sortByOrder %}
      {% for service in services %}
        <article class="service-card{% if service.data.coming_soon %} service-card--coming-soon{% endif %}">
          <div class="card-image{% if not service.data.cover_image %} card-image--placeholder{% endif %}">
            {% if service.data.cover_image %}
              <img src="{{ service.data.cover_image | toPublicPath }}"
                   alt="{{ service.data.title }} - Accompagnement et performance à Neuchâtel"
                   loading="lazy" width="400" height="240">
            {% else %}
              <svg class="card-image-placeholder-icon" aria-hidden="true"><use href="/assets/img/icons/sprite.svg#icon-{{ service.data.icon or 'image' }}"></use></svg>
            {% endif %}
            <div class="card-id" aria-hidden="true">{{ service.data.order | padStart(2, '0') }}</div>
            {% if service.data.coming_soon %}
              <div class="coming-soon-badge">
                <svg class="icon" style="width:1rem;height:1rem;vertical-align:middle;" aria-hidden="true"><use href="/assets/img/icons/sprite.svg#icon-schedule"></use></svg>
                À venir
              </div>
            {% endif %}
          </div>
          <div class="card-content">
            <h3>{{ service.data.title }}</h3>
            <p>{{ service.data.summary }}</p>
            <a href="{{ service.url }}" class="card-link">En savoir plus →</a>
          </div>
        </article>
      {% endfor %}
    </div>

  </div>
</section>
