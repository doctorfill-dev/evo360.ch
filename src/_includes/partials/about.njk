{#
  about.njk — Section "Notre approche".
  - .about-image (position:relative) contient .main-img-wrap + .experience-badge
  - Le badge est à l'extérieur du overflow:hidden pour ne pas être coupé
  - home.about.title contient du HTML → filtre `safe`
#}
<section class="about" id="about">
  <div class="container about-grid">

    {# Colonne gauche : image + badge citron #}
    <div class="about-image">
      <div class="main-img-wrap">
        <img
          src="{{ home.about.image | toPublicPath }}"
          alt="Équipe d'experts en physiologie du sport et accompagnement bien-être à Neuchâtel"
          class="main-img"
          loading="lazy">
      </div>
      <div class="experience-badge">
        <span class="number">25+</span>
        <span class="text">Années d'expertise cumulées</span>
      </div>
    </div>

    {# Colonne droite : texte #}
    <div class="about-content">
      <h2 class="section-title">{{ home.about.title | safe }}</h2>
      <p class="about-lead">{{ home.about.lead }}</p>
      <div class="about-body">
        <p>{{ home.about.body_text }}</p>
      </div>
      {#
      <div class="quote-card">
        <p>« {{ home.about.quote }} »</p>
        {% if home.about.quote_author %}
          <cite class="quote-author">{{ home.about.quote_author }}</cite>
        {% endif %}
      </div>
      #}

      <div class="features-grid">
        <div class="feature">
          <div class="feature-icon">
            <svg class="icon" aria-hidden="true"><use href="/assets/img/icons/sprite.svg#icon-hearing"></use></svg>
          </div>
          <div><h3>Écoute</h3><p>Chaque parcours part de votre histoire</p></div>
        </div>
        <div class="feature">
          <div class="feature-icon">
            <svg class="icon" aria-hidden="true"><use href="/assets/img/icons/sprite.svg#icon-groups"></use></svg>
          </div>
          <div><h3>Accompagnement</h3><p>Un suivi à chaque étape</p></div>
        </div>
        <div class="feature">
          <div class="feature-icon">
            <svg class="icon" aria-hidden="true"><use href="/assets/img/icons/sprite.svg#icon-verified_user"></use></svg>
          </div>
          <div><h3>Respect</h3><p>Vos limites sont notre boussole</p></div>
        </div>
        <div class="feature">
          <div class="feature-icon">
            <svg class="icon" aria-hidden="true"><use href="/assets/img/icons/sprite.svg#icon-trending_up"></use></svg>
          </div>
          <div><h3>Durabilité</h3><p>Des résultats dans le temps</p></div>
        </div>
      </div>
      <div style="margin-top:2.5rem;">
        <a href="/about/" class="btn btn-primary">En savoir plus sur evo360</a>
      </div>
    </div>

  </div>
</section>
