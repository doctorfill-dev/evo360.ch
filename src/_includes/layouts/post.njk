---
layout: layouts/base.njk
---
<article class="post-detail">
  <header class="post-header">
    <div class="container">
      <div class="post-header-content">
        <a href="/blog/" class="back-link back-link-light" style="color: var(--indigo);">
          <span class="material-symbols-outlined" style="font-size:1rem;vertical-align:middle;">arrow_back</span>
          Tous les articles
        </a>
        {% if publishedDate %}
          <span class="post-date">{{ publishedDate | readableDate }}</span>
        {% endif %}
        <h1>{{ title }}</h1>
        <p class="post-summary">{{ summary }}</p>
        <span class="post-author">Par {{ author }}</span>
      </div>
    </div>
  </header>

  {% if cover_image %}
  <div class="post-cover">
    <div class="container">
      <img src="{{ cover_image | toPublicPath }}" alt="{{ title }}" loading="lazy">
    </div>
  </div>
  {% endif %}

  <div class="prose-container">
    <div class="prose">
      {{ content | safe }}
    </div>

    <div class="detail-footer">
      <a href="/blog/" class="back-link">← Voir tous les articles</a>
    </div>
  </div>
</article>
