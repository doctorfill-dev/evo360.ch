---
layout: layouts/base.njk
---
<article class="service-detail">
  {# `prices: []` is truthy in Nunjucks, so test its length explicitly. #}
  {% set hasPriceGrid = prices and prices.length > 0 %}
  {% set hasServiceTariff = price or hasPriceGrid or price_note or page.fileSlug == 'fitness' %}
  <header class="service-header-refined">
    {# Price badge — single price #}
    {% if price and not hasPriceGrid %}
      <div class="service-price-badge">
        <span class="service-price-badge-amount">{{ price }}</span>
        {% if price_note %}
          <span class="service-price-badge-note">{{ price_note }}</span>
        {% endif %}
      </div>
    {% endif %}

    {# Price badge — multiple prices: link to tarifs section #}
    {% if hasPriceGrid or page.fileSlug == 'fitness' %}
      <a href="#tarifs" class="service-price-badge service-price-badge--link">
        <span class="service-price-badge-amount">Tarifs</span>
        <span class="service-price-badge-note">Voir ci-dessous ↓</span>
      </a>
    {% endif %}

    <div class="container service-header-grid">
      <div class="service-header-text">
        <a href="/#services" class="back-link back-link-light">
          <svg class="icon" style="width:1rem;height:1rem;vertical-align:middle;" aria-hidden="true"><use href="/assets/img/icons/sprite.svg#icon-arrow_back"></use></svg>
          Retour aux services
        </a>
        <div class="service-icon-wrap">
          <svg class="icon service-mat-icon" aria-hidden="true"><use href="/assets/img/icons/sprite.svg#icon-{{ icon }}"></use></svg>
        </div>
        <h1>{{ title }}</h1>
        {% if coming_soon %}
        <div class="coming-soon-badge">
          <svg class="icon" style="width:1rem;height:1rem;vertical-align:middle;" aria-hidden="true"><use href="/assets/img/icons/sprite.svg#icon-schedule"></use></svg>
          Offre à venir
        </div>
        {% endif %}
        <p class="service-summary">{{ summary }}</p>
      </div>
      {% if cover_image %}
        <div class="service-header-image">
          <img src="{{ cover_image | toPublicPath }}" alt="{{ title }} | Performance et bien-être à Neuchâtel" loading="lazy">
        </div>
      {% endif %}
    </div>
  </header>

  <div class="prose-container">
    <div class="prose">
      {{ content | safe }}
    </div>

    {# Price table at bottom — supports a unique price, a grid, or a quote note. #}
    {% if hasServiceTariff %}
      <section class="service-tarifs" id="tarifs">
        <h2 class="service-tarifs-title">
          <svg class="icon" style="width:1.5rem;height:1.5rem;vertical-align:middle;" aria-hidden="true"><use href="/assets/img/icons/sprite.svg#icon-payments"></use></svg>
          Nos tarifs
        </h2>
        <ul class="service-tarifs-list">
          {% if page.fileSlug == 'fitness' %}
            {% for plan in home.pricing.plans %}
              <li class="service-tarifs-item">
                <span class="service-tarifs-label">Abonnement {{ plan.name }}</span>
                <span class="service-tarifs-amount">{{ plan.price_months }} {{ plan.period_months }} — ou {{ plan.price_onetime }} {{ plan.period_onetime }}</span>
              </li>
            {% endfor %}
          {% elif hasPriceGrid %}
            {% for item in prices %}
              <li class="service-tarifs-item">
                <span class="service-tarifs-label">{{ item.label }}</span>
                <span class="service-tarifs-amount">{{ item.amount }}</span>
              </li>
            {% endfor %}
          {% elif price %}
            <li class="service-tarifs-item">
              <span class="service-tarifs-label">{{ price_label or 'Tarif' }}</span>
              <span class="service-tarifs-amount">{{ price }}</span>
            </li>
          {% endif %}
        </ul>
        {% if price_note %}
          <p class="service-tarifs-note">{{ price_note }}</p>
        {% endif %}
      </section>
    {% endif %}

    <div class="detail-footer">
      <div class="detail-cta">
        {% set defaultServiceCtaUrl = '/contact/?motif=' ~ (title | urlencode) %}
        {% set serviceCtaUrl = cta_url or defaultServiceCtaUrl %}
        {% set serviceCtaIsExternal = cta_url and '://' in cta_url %}
        <h3>Intéressé par ce service ?</h3>
        <p>Prenez rendez-vous pour un premier échange et découvrez comment nous pouvons vous accompagner.</p>
        <a href="{{ serviceCtaUrl }}" class="btn btn-primary"{% if serviceCtaIsExternal %} target="_blank" rel="noopener"{% endif %}>{{ cta_label or 'Prendre rendez-vous' }}</a>
      </div>

      {# Navigation précédent / suivant #}
      {% set allServices = collections.services | removeHidden | sort(false, false, 'data.order') %}
      {% set currentIndex = allServices | findServiceIndex(page.url) %}

      <nav class="service-nav" aria-label="Navigation entre services">
        <div class="service-nav-grid">
          {% if currentIndex > 0 %}
            <a href="{{ allServices[currentIndex - 1].url }}" class="service-nav-link service-nav-prev">
              <span class="nav-direction">
                <svg class="icon" style="width:.875rem;height:.875rem;vertical-align:middle;" aria-hidden="true"><use href="/assets/img/icons/sprite.svg#icon-arrow_back"></use></svg>
                Précédent
              </span>
              <span class="nav-service-title">{{ allServices[currentIndex - 1].data.title }}</span>
            </a>
          {% else %}
            <div></div>
          {% endif %}

          {% if currentIndex >= 0 and currentIndex < allServices.length - 1 %}
            <a href="{{ allServices[currentIndex + 1].url }}" class="service-nav-link service-nav-next">
              <span class="nav-direction">
                Suivant
                <svg class="icon" style="width:.875rem;height:.875rem;vertical-align:middle;" aria-hidden="true"><use href="/assets/img/icons/sprite.svg#icon-arrow_forward"></use></svg>
              </span>
              <span class="nav-service-title">{{ allServices[currentIndex + 1].data.title }}</span>
            </a>
          {% endif %}
        </div>
      </nav>
    </div>
  </div>
</article>
