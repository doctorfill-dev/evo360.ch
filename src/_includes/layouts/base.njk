{#
  base.njk — Layout de base.
  Variables depuis le front matter : title, description.
  content → injecté par Eleventy (le HTML de la page enfant).
#}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {%- set metaDesc = description or summary or home.hero.description -%}
  <title>{{ title if page.url != "/" else "evo360 | Centre de Santé, Performance et Bien-être à Neuchâtel" }}</title>
  <meta name="description" content="{{ description if page.url != "/" else "Découvrez evo360 à Neuchâtel. Une approche globale sur mesure : préparation physique, bilan physiologique, prévention des blessures et récupération." }}">

  {# SEO — Canonical URL #}
  <link rel="canonical" href="{{ home.site.url }}{{ page.url }}">

  {# SEO — Open Graph #}
  <meta property="og:type" content="website">
  <meta property="og:locale" content="fr_CH">
  <meta property="og:site_name" content="{{ home.site.name }}">
  <meta property="og:title" content="{{ title if page.url != "/" else "evo360 | Centre de Santé, Performance et Bien-être à Neuchâtel" }}">
  <meta property="og:description" content="{{ description if page.url != "/" else "Découvrez evo360 à Neuchâtel. Une approche globale sur mesure : préparation physique, bilan physiologique, prévention des blessures et récupération." }}">
  <meta property="og:url" content="{{ home.site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ home.site.url }}{% if cover_image %}{{ cover_image | toPublicPath }}{% else %}{{ home.site.og_image | toPublicPath }}{% endif %}">

  {# SEO — Twitter Card #}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title if page.url != "/" else "evo360 | Centre de Santé, Performance et Bien-être à Neuchâtel" }}">
  <meta name="twitter:description" content="{{ description if page.url != "/" else "Découvrez evo360 à Neuchâtel. Une approche globale sur mesure : préparation physique, bilan physiologique, prévention des blessures et récupération." }}">
  <meta name="twitter:image" content="{{ home.site.url }}{% if cover_image %}{{ cover_image | toPublicPath }}{% else %}{{ home.site.og_image | toPublicPath }}{% endif %}">

  {# PWA — Theme color #}
  <meta name="theme-color" content="#4622CC">

  <link rel="icon" href="/assets/img/favicon.ico" type="image/x-icon">
  <link rel="stylesheet" href="/assets/css/style.css">
  <script src="/assets/js/main.js" defer></script>

  {# Google Fonts : Inter (body) + Outfit (headings) — preconnect for speed #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@700;800;900&display=swap" rel="stylesheet">

  {# Google Material Symbols #}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0">

  {# Structured Data — LocalBusiness (JSON-LD) #}
  {% if page.url == "/" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "HealthAndBeautyBusiness",
    "name": "evo360",
    "description": "Découvrez evo360 à Neuchâtel. Une approche globale sur mesure : préparation physique, bilan physiologique, prévention des blessures et récupération.",
    "url": "https://evo360.ch",
    "telephone": "+41765070360",
    "email": "v3@evo360.ch",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Av. Édouard-Dubois 20",
      "addressLocality": "Neuchâtel",
      "postalCode": "2000",
      "addressCountry": "CH"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 46.9958,
      "longitude": 6.9293
    },
    "image": "https://evo360.ch/assets/img/lieu/hero.webp",
    "priceRange": "CHF 89 - 1320",
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
        "opens": "07:30",
        "closes": "20:30"
      }
    ],
    "sameAs": [
      "https://www.instagram.com/evo360.ch"
    ]
  }
  </script>
  {% endif %}
</head>
<body{% if page.url != "/" %} class="inner-page"{% endif %}>

  <a href="#main-content" class="skip-link">Aller au contenu principal</a>

  {% include "partials/promo.njk" %}
  {% include "partials/header.njk" %}

  <main id="main-content">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}
  {% include "partials/modal-form.njk" %}

  <script>
    // Header : frosted glass au scroll (sticky header)
    const header = document.getElementById('site-header');

    // Force frosted header on inner pages (cream/white backgrounds)
    if (document.body.classList.contains('inner-page')) {
      header.classList.add('is-scrolled');
    }

    window.addEventListener('scroll', () => {
      if (document.body.classList.contains('inner-page')) {
        header.classList.add('is-scrolled');
      } else {
        header.classList.toggle('is-scrolled', window.scrollY > 50);
      }
    }, { passive: true });

    // Burger menu mobile
    const burger = document.getElementById('nav-burger');
    const mobileNav = document.getElementById('mobile-nav');
    if (burger && mobileNav) {
      burger.addEventListener('click', () => {
        const isOpen = !mobileNav.hidden;
        mobileNav.hidden = isOpen;
        burger.setAttribute('aria-expanded', String(!isOpen));
      });
      mobileNav.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          mobileNav.hidden = true;
          burger.setAttribute('aria-expanded', 'false');
        });
      });
    }

    // Dropdown menus (keyboard accessibility)
    document.querySelectorAll('.nav-dropdown-parent').forEach(item => {
      const link = item.querySelector('.nav-link');
      if (link) {
        link.addEventListener('focus', () => item.classList.add('dropdown-open'));
        link.addEventListener('blur', () => {
          setTimeout(() => {
            if (!item.contains(document.activeElement)) item.classList.remove('dropdown-open');
          }, 100);
        });
      }
    });

    // Promo bar dismiss (with localStorage persistence)
    const promoBar = document.getElementById('promo-bar');
    const promoClose = document.getElementById('promo-close');
    if (promoBar && promoClose) {
      if (localStorage.getItem('promo-dismissed') === 'true') {
        promoBar.remove();
      }
      promoClose.addEventListener('click', () => {
        promoBar.remove();
        localStorage.setItem('promo-dismissed', 'true');
      });
    }

    // Modal contact form
    const modal = document.getElementById('modal-contact');
    const modalClose = document.getElementById('modal-close');
    const motifSelect = document.getElementById('motif');

    function openModal(motif) {
      if (!modal) return;
      if (motif && motifSelect) {
        motifSelect.value = motif;
      }
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      modalClose.focus();
    }

    function closeModal() {
      if (!modal) return;
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    if (modalClose) {
      modalClose.addEventListener('click', closeModal);
    }
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && modal.getAttribute('aria-hidden') === 'false') {
        closeModal();
      }
    });

    // Open modal from any element with data-open-modal="contact"
    document.querySelectorAll('[data-open-modal="contact"]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openModal(btn.dataset.motif || '');
      });
    });

    // Handle hash #contact — open modal on page load or nav
    function checkContactHash() {
      if (window.location.hash === '#contact') {
        openModal('');
        history.replaceState(null, '', window.location.pathname);
      }
    }
    checkContactHash();
    window.addEventListener('hashchange', checkContactHash);
  </script>

  <div id="cookie-banner" class="cookie-banner" hidden>
    <div class="cookie-content">
      <h3 class="footer-title">Respect de votre vie privée</h3>
      <p>Nous utilisons des cookies pour améliorer votre expérience et analyser le trafic sur notre site (Google Analytics). Vous pouvez choisir d'accepter ou de refuser ces cookies.</p>
    </div>
    <div class="cookie-actions">
      <button id="cookie-accept" class="btn btn-primary btn-sm">Accepter</button>
      <button id="cookie-decline" class="btn btn-outline btn-sm">Refuser</button>
    </div>
  </div>

</body>
</html>
