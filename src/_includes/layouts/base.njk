{#
  base.njk — Layout de base.
  Variables depuis le front matter : title, description.
  content → injecté par Eleventy (le HTML de la page enfant).
#}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {%- set metaDesc = summary or description or home.hero.description -%}
  {%- set metaTitle = title + " | evo360 Neuchâtel" if page.url != "/" else "evo360 | Centre de Performance et Bien-être à Neuchâtel" -%}
  {%- set metaDescription = metaDesc if page.url != "/" else "Découvrez evo360 à Neuchâtel. Une approche globale sur mesure : préparation physique, bilan physiologique, coaching personnalisé et récupération." -%}
  <title>{{ metaTitle }}</title>
  <meta name="description" content="{{ metaDescription }}">

  {# SEO — Canonical URL #}
  <link rel="canonical" href="{{ home.site.url }}{{ page.url }}">

  {# SEO — Open Graph #}
  <meta property="og:type" content="website">
  <meta property="og:locale" content="fr_CH">
  <meta property="og:site_name" content="{{ home.site.name }}">
  <meta property="og:title" content="{{ metaTitle }}">
  <meta property="og:description" content="{{ metaDescription }}">
  <meta property="og:url" content="{{ home.site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ home.site.url }}{% if cover_image %}{{ cover_image | toPublicPath }}{% else %}{{ home.site.og_image | toPublicPath }}{% endif %}">

  {# SEO — Twitter Card #}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ metaTitle }}">
  <meta name="twitter:description" content="{{ metaDescription }}">
  <meta name="twitter:image" content="{{ home.site.url }}{% if cover_image %}{{ cover_image | toPublicPath }}{% else %}{{ home.site.og_image | toPublicPath }}{% endif %}">

  {# PWA — Theme color, manifest, apple touch icon #}
  <meta name="theme-color" content="#4622CC">
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">

  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/img/favicon.ico" type="image/x-icon">

  {# ── Font preloads (eliminate CLS from font swap) ── #}
  <link rel="preload" href="/assets/fonts/outfit-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>

  {# ── Critical CSS (inlined for FCP performance) ── #}
