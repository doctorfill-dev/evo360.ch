---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- for page in collections.all %}
  {%- if not page.data.eleventyExcludeFromCollections and page.url %}
  <url>
    <loc>{{ home.site.url }}{{ page.url }}</loc>
    <lastmod>{{ page.date | isoDate }}</lastmod>
    <changefreq>{% if page.url == "/" %}weekly{% else %}monthly{% endif %}</changefreq>
    <priority>{% if page.url == "/" %}1.0{% elif "/services/" in page.url %}0.8{% elif "/blog/" in page.url %}0.7{% else %}0.5{% endif %}</priority>
  </url>
  {%- endif %}
  {%- endfor %}
</urlset>
