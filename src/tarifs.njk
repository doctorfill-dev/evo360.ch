---
layout: layouts/base.njk
title: Tarifs
description: Tous les tarifs evo360 à Neuchâtel. Fitness, coaching, VO₂max, Red Light Therapy, nutrition, neurotracker et plus.
---

<section class="pricing-page">
  <div class="container">
    <div class="pricing-page-header">
      <h1 class="section-title">Tous nos <span class="accent">tarifs</span></h1>
      <p>Retrouvez l'ensemble de nos prestations et tarifs. Pour toute question, n'hésitez pas à nous contacter.</p>
    </div>

    {# — Fitness & Sauna — #}
    <div class="tarif-block" id="fitness">
      <div class="tarif-block-header">
        <svg class="icon tarif-block-icon" aria-hidden="true"><use href="/assets/img/icons/sprite.svg#icon-fitness_center"></use></svg>
        <div>
          <h2>Fitness & Sauna</h2>
          <p>Accès libre du lundi au vendredi, 07h30–20h30. Machines Technogym & Sensopro, espace bien-être avec sauna.</p>
        </div>
      </div>
      <div class="pricing-grid">
        {% for plan in home.pricing.plans %}
          <div class="pricing-card {% if plan.highlight %}highlighted{% endif %}">
            <div class="plan-header">
              <h3>{{ plan.name }}</h3>
              <div class="plan-price">
                <div class="price-monthly">
                  <span class="amount">{{ plan.price_months }}</span>
                  <span class="period">{{ plan.period_months }}</span>
                </div>
                <div class="price-onetime">
                  <span><strong>ou {{ plan.price_onetime }} {{ plan.period_onetime }}</strong></span>
                </div>
              </div>
              <p class="plan-desc">{{ plan.description }}</p>
            </div>
            <ul class="plan-features">
              {% for feature in plan.features %}
                <li>
                  <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                  {{ feature }}
                </li>
              {% endfor %}
            </ul>
            <div class="plan-cta">
              <a href="/contact/?motif=Abonnement+{{ plan.name | urlencode }}" class="btn {% if plan.highlight %}btn-primary{% else %}btn-outline{% endif %}">{{ plan.cta_label }}</a>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    {# — Services individuels — #}
    <div class="tarif-block" id="services">
      <div class="tarif-block-header">
        <svg class="icon tarif-block-icon" aria-hidden="true"><use href="/assets/img/icons/sprite.svg#icon-paid"></use></svg>
        <div>
          <h2>Prestations & services</h2>
          <p>Nos tarifs pour l'ensemble de nos prestations individuelles.</p>
        </div>
      </div>

      {% set services = collections.services | removeHidden | sortByOrder %}
      <div class="tarif-services-grid">
        {% for service in services %}
          {% if service.fileSlug != 'fitness' and (service.data.price or (service.data.prices and service.data.prices.length) or service.data.price_note or service.data.cta_url) %}
            <div class="tarif-service-card">
              <div class="tarif-service-head">
                {% if service.data.icon %}
                  <svg class="icon" aria-hidden="true"><use href="/assets/img/icons/sprite.svg#icon-{{ service.data.icon }}"></use></svg>
                {% endif %}
                <h3>{{ service.data.title }}</h3>
                {% if service.data.coming_soon %}
                  <span class="coming-soon-badge" style="font-size:.7rem;padding:.15rem .5rem;">Bientôt</span>
                {% endif %}
              </div>

              {% if service.data.price %}
                <ul class="tarif-list">
                  <li><span>{{ service.data.price_label or 'Tarif' }}</span><strong>{{ service.data.price }}</strong></li>
                </ul>
              {% endif %}

              {% if service.data.prices and service.data.prices.length %}
                <ul class="tarif-list">
                  {% for item in service.data.prices %}
                    <li><span>{{ item.label }}</span><strong>{{ item.amount }}</strong></li>
                  {% endfor %}
                </ul>
              {% endif %}

              {% if service.data.price_note %}
                <p class="tarif-note">{{ service.data.price_note }}</p>
              {% endif %}

              {% if service.data.cta_url %}
                <div class="plan-cta" style="margin-top:.75rem;">
                  <a href="{{ service.data.cta_url }}" class="btn btn-outline btn-sm"{% if '://' in service.data.cta_url %} target="_blank" rel="noopener"{% endif %}>{{ service.data.cta_label or 'Prendre rendez-vous' }}</a>
                </div>
              {% elif not service.data.price and not (service.data.prices and service.data.prices.length) and service.data.price_note %}
                <div class="plan-cta" style="margin-top:.75rem;">
                  <a href="/contact/?motif={{ service.data.title | urlencode }}" class="btn btn-outline btn-sm">Demander un devis</a>
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {# CTA #}
    <div class="tarif-cta">
      <p>Une question sur nos tarifs ? Besoin d'un programme personnalisé ?</p>
      <a href="/contact/" class="btn btn-primary">Nous contacter</a>
    </div>

  </div>
</section>
